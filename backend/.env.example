# Copy this file to ".env" and change the values.

# Long random text used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Local database (SQLite file). On Render this is set for you automatically.
# DATABASE_URL=sqlite:///./vulnsight.db

# Where your React app runs (comma-separated if more than one).
FRONTEND_URLS=http://localhost:5173

# true  = allow scanning localhost / 192.168.x.x (good for practice labs like DVWA)
# false = only public internet targets (USE THIS WHEN DEPLOYED)
ALLOW_PRIVATE_TARGETS=true
